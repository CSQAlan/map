APP_NAME=elder-map-backend
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/elder_map
REDIS_URL=redis://127.0.0.1:6379/0
# Required in production to sign administrator sessions used for survey pin edits.
ADMIN_TOKEN_SECRET=
# Required in production to sign administrator sessions used for survey pin edits.
ADMIN_TOKEN_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost
# Development only: allow LAN origins for physical-device browser debugging.
CORS_ALLOW_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+)(:\d+)?
