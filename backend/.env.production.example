APP_NAME=elder-map-backend
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DATABASE_HOST:5432/elder_map
REDIS_URL=redis://REDIS_HOST:6379/0
# Keep https://localhost for the Capacitor Android WebView.
CORS_ORIGINS=https://localhost
# Empty disables development LAN-origin matching in production.
CORS_ALLOW_ORIGIN_REGEX=
# Required: use a unique, randomly generated secret of at least 32 bytes.
ADMIN_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
