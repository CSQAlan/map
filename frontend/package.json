{
  "name": "elder-map-h5-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "build:android": "node scripts/validate-production-env.mjs && vite build --mode production",
    "build:android:lan": "node scripts/validate-lan-api.mjs && vite build --mode development",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:sync:lan": "npm run build:android:lan && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build:android && npx cap sync android && npx cap build android",
    "android:apk:lan": "npm run android:sync:lan && cd android && gradlew.bat assembleDebug",
    "test:ui": "node scripts/check-mobile-ui.mjs",
    "test:assistant:live": "node scripts/check-assistant-live.mjs",
    "test:speech-navigation": "node scripts/check-speech-navigation.mjs",
    "test:map": "node scripts/check-map-lifecycle.mjs",
    "test:speech:live": "node scripts/check-speech-live.mjs"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "1.0.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@vitejs/plugin-vue": "6.0.7",
    "vite": "8.1.4",
    "vue": "3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
